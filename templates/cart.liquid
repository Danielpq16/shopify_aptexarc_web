{%- comment -%}
  ============================================================================
  templates/cart.liquid — Shopping cart page.
  Replaces v2/cart.html. Differences vs the static file:
    1. Cart contents come from the Shopify {{ cart }} object (line items,
       quantities, line prices). No localStorage, no hardcoded product.
    2. Quantity +/- and Remove call /cart/change.js via fetch and re-render
       the whole cart by reloading. The visual states are identical.
    3. The promo input talks to Shopify's native discount system:
         · APPLY → redirects to /discount/LAUNCH10?redirect=/cart, which
           tells Shopify to attach the code to the cart cookie.
         · After redirect, cart.discount_applications carries LAUNCH10 and
           the green "Promo: LAUNCH10 (10%)" line appears with the real
           discounted total — calculated by Shopify, valid through checkout.
         · REMOVE clears the discount via POST /cart/update.js {discount:''}
           and reloads.
    4. The error message + readonly input + REMOVE button styling all match
       the original UI 1:1 — the only thing that changed is who computes the
       maths (Shopify, not JS).
  ============================================================================
{%- endcomment -%}

{%- comment -%}
  Detect whether LAUNCH10 (or any code) is currently applied. Used to flip
  the input + button into the "applied" state on first paint, so the page is
  authoritative without waiting for JS.
{%- endcomment -%}
{%- assign promo_applied      = false -%}
{%- assign promo_code         = '' -%}
{%- assign promo_savings      = 0 -%}
{%- for discount in cart.cart_level_discount_applications -%}
  {%- assign promo_applied = true -%}
  {%- assign promo_code    = discount.title -%}
  {%- assign promo_savings = promo_savings | plus: discount.total_allocated_amount -%}
{%- endfor -%}

<main class="max-w-max-width mx-auto px-margin py-xl min-h-screen">

  <div class="mb-lg">
    <h1 class="font-headline-lg text-headline-lg">Shopping Cart</h1>
    <p class="text-on-surface-variant font-body-md mt-base">Review your selection of honest hardware.</p>
  </div>

  {%- if cart.item_count == 0 -%}

    <!-- Empty state ============================================================ -->
    <div id="cartEmpty"
         class="bg-surface-container border border-outline-variant p-lg flex flex-col items-center text-center gap-sm max-w-2xl mx-auto">
      <span class="material-symbols-outlined text-primary text-[48px]">remove_shopping_cart</span>
      <h3 class="font-headline-md text-headline-md">Your cart is empty</h3>
      <p class="text-on-surface-variant font-body-md">Add a console to get started.</p>
      <a href="{{ routes.root_url }}#colors"
         class="inline-block mt-sm bg-primary-container text-on-primary-container px-lg py-sm font-label-sm text-label-sm tracking-widest hover:brightness-110 active:scale-95 transition-all">
        BROWSE PRODUCTS
      </a>
    </div>

  {%- else -%}

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-md items-start">

      <!-- Cart items ============================================================ -->
      <div class="lg:col-span-8 space-y-md">

        <!-- Table Header (Desktop) ============================================ -->
        <div id="cartHeader" class="hidden md:grid grid-cols-12 border-b border-outline-variant pb-sm px-sm text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
          <div class="col-span-6">Product</div>
          <div class="col-span-2 text-center">Quantity</div>
          <div class="col-span-4 text-right">Subtotal</div>
        </div>

        {%- comment -%}
          Iterate every line in the cart. cart.items is ordered by the
          insertion sequence; each `item` carries `key`, `quantity`,
          `final_line_price`, `image`, `product`, `variant`, etc.
        {%- endcomment -%}
        {%- for item in cart.items -%}
          <div class="bg-surface-container border border-outline-variant p-md flex flex-col md:grid md:grid-cols-12 md:items-center gap-md cart-line"
               data-line-key="{{ item.key }}"
               data-line-index="{{ forloop.index }}">

            <div class="md:col-span-6 flex items-center gap-md">
              <a href="{{ item.url }}" class="w-24 h-24 bg-surface-container-highest border border-outline-variant overflow-hidden flex-shrink-0">
                {%- if item.image != blank -%}
                  <img alt="{{ item.product.title }} {{ item.variant.title }}"
                       class="w-full h-full object-cover"
                       src="{{ item.image | image_url: width: 240 }}"
                       width="96" height="96"
                       loading="lazy">
                {%- endif -%}
              </a>
              <div class="flex flex-col">
                <a href="{{ item.url }}" class="font-headline-md text-headline-md hover:text-primary transition-colors">
                  {{ item.product.title }}{% unless item.variant.title contains 'Default' %} - {{ item.variant.title }}{% endunless %}
                </a>
                {%- if item.variant.option1 != blank and item.product.options.first == 'Color' -%}
                  <span class="text-on-surface-variant font-label-sm text-label-sm uppercase mt-xs">
                    Color: {{ item.variant.option1 }}
                  </span>
                {%- endif -%}
                <button type="button"
                        class="text-primary font-label-sm text-label-sm flex items-center mt-sm hover:opacity-80 transition-opacity remove-btn"
                        data-line-key="{{ item.key }}"
                        aria-label="Remove {{ item.product.title }} from cart">
                  <span class="material-symbols-outlined text-[16px] mr-1">delete</span> Remove
                </button>
              </div>
            </div>

            <div class="md:col-span-2 flex items-center justify-center">
              <div class="flex items-center border border-outline-variant bg-surface">
                <button type="button"
                        class="qty-dec w-8 h-8 flex items-center justify-center hover:bg-surface-variant/20 transition-colors"
                        data-line-key="{{ item.key }}"
                        aria-label="Decrease quantity">
                  <span class="material-symbols-outlined text-sm">remove</span>
                </button>
                <span class="qty-val w-10 text-center font-label-sm text-label-sm" aria-live="polite">{{ item.quantity }}</span>
                <button type="button"
                        class="qty-inc w-8 h-8 flex items-center justify-center hover:bg-surface-variant/20 transition-colors"
                        data-line-key="{{ item.key }}"
                        aria-label="Increase quantity">
                  <span class="material-symbols-outlined text-sm">add</span>
                </button>
              </div>
            </div>

            <div class="md:col-span-4 text-right">
              <span class="font-headline-md text-headline-md">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        {%- endfor -%}

        <!-- Promo + Continue Shopping ========================================= -->
        <div id="cartActions" class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md pt-sm">
          {%- comment -%}
            Promo form. We don't actually let the form submit — JS intercepts
            and either redirects to /discount/CODE (apply) or POSTs to
            /cart/update.js with discount:'' (remove). The form `action` is
            still set as a graceful fallback if JS is disabled (clicking the
            button posts the visible code as a discount via Shopify's stock
            cart endpoint).
          {%- endcomment -%}
          <form id="promoForm" action="{{ routes.cart_url }}" method="post" class="flex flex-col gap-xs w-full md:w-auto" novalidate>
            <label class="font-label-sm text-label-sm text-on-surface-variant" for="promo">PROMO CODE</label>
            <div class="flex items-center gap-xs">
              <input id="promo"
                     name="discount"
                     class="bg-surface border border-outline-variant px-sm py-2 text-on-surface focus:border-primary outline-none font-body-md w-full md:w-48 placeholder:text-outline transition-colors {% if promo_applied %}opacity-60{% endif %}"
                     placeholder="Enter code"
                     type="text"
                     autocomplete="off"
                     value="{% if promo_applied %}{{ promo_code }}{% endif %}"
                     {% if promo_applied %}readonly{% endif %}
                     aria-describedby="promoMsg">
              <button id="promoBtn"
                      type="submit"
                      class="border px-md py-2 font-label-sm text-label-sm transition-colors {% if promo_applied %}border-error text-error hover:bg-error/10{% else %}border-outline-variant hover:bg-surface-variant/10{% endif %}"
                      aria-label="{% if promo_applied %}Remove promo code{% else %}Apply promo code{% endif %}">
                {% if promo_applied %}REMOVE{% else %}APPLY{% endif %}
              </button>
            </div>
            <p id="promoMsg" class="font-label-sm text-label-sm min-h-[16px] mt-xs" role="status" aria-live="polite"></p>
          </form>
          <a href="{{ routes.root_url }}#colors" class="flex items-center gap-xs text-on-surface-variant font-label-sm text-label-sm hover:text-on-surface transition-colors">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Continue Shopping
          </a>
        </div>
      </div>

      <!-- Order Summary ============================================================ -->
      <aside class="lg:col-span-4 sticky top-24">
        <div class="bg-surface-container border border-outline-variant p-md space-y-md">
          <h2 class="font-headline-md text-headline-md border-b border-outline-variant pb-sm">Order Summary</h2>

          <div class="space-y-sm">
            {%- comment -%}
              Subtotal = original price before any cart-level discounts.
              In the cart object that is `cart.items_subtotal_price`.
            {%- endcomment -%}
            <div class="flex justify-between font-body-md text-body-md">
              <span class="text-on-surface-variant">Subtotal</span>
              <span>{{ cart.items_subtotal_price | money }}</span>
            </div>

            <div class="flex justify-between font-body-md text-body-md">
              <span class="text-on-surface-variant">Shipping</span>
              <span class="text-outline italic">Calculated next step</span>
            </div>

            {%- comment -%}
              Render every cart-level discount Shopify reports. With LAUNCH10
              that's a single line; if the merchant configures more codes
              they all appear, each in primary green to mirror the original.
              `discount.value` is the percentage (Shopify exposes it as a
              float for percentage discounts) — we round to a clean integer.
            {%- endcomment -%}
            {%- if promo_applied -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                {%- assign pct = discount.value | times: 1 | round -%}
                <div class="flex justify-between font-body-md text-body-md text-primary">
                  <span>Promo: {{ discount.title }}{% if discount.value_type == 'percentage' %} ({{ pct }}%){% endif %}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <div class="border-t border-outline-variant pt-md flex justify-between items-end">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Estimated Total</span>
            <span class="font-headline-lg text-headline-lg text-primary">{{ cart.total_price | money }}</span>
          </div>

          {%- comment -%}
            Real cart submit form — Shopify's checkout flow. Posts the cart
            note + any other extras and redirects to checkout.shopify.com.
          {%- endcomment -%}
          <form action="{{ routes.cart_url }}" method="post" novalidate>
            <input type="hidden" name="checkout" value="">
            <button type="submit"
                    name="checkout"
                    id="checkoutBtn"
                    class="w-full bg-primary-container text-on-primary-container font-headline-md py-md hover:brightness-110 active:scale-[0.98] transition-all flex items-center justify-center gap-sm disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:brightness-100"
                    {% if cart.item_count == 0 %}disabled{% endif %}>
              CHECKOUT NOW
              <span class="material-symbols-outlined">lock</span>
            </button>
          </form>

          <div class="flex flex-col gap-xs pt-sm text-on-surface-variant font-label-sm text-label-sm">
            <p class="flex items-center gap-xs">
              <span class="material-symbols-outlined text-[14px]">verified_user</span>
              Secure checkout with SSL encryption
            </p>
          </div>
        </div>
      </aside>

    </div>

  {%- endif -%}

  <!-- Trust Badges (static) ===================================================== -->
  <section class="mt-xl border-t border-outline-variant pt-xl grid grid-cols-1 md:grid-cols-3 gap-lg">
    <div class="flex items-center gap-md">
      <div class="w-12 h-12 flex items-center justify-center bg-surface-container-high border border-primary/20">
        <span class="material-symbols-outlined text-primary text-3xl">local_shipping</span>
      </div>
      <div>
        <h3 class="font-label-sm text-label-sm text-on-surface uppercase tracking-widest">Global Express</h3>
        <p class="text-on-surface-variant font-label-sm text-label-sm mt-1">Tracked shipping to 50+ countries.</p>
      </div>
    </div>
    <div class="flex items-center gap-md">
      <div class="w-12 h-12 flex items-center justify-center bg-surface-container-high border border-primary/20">
        <span class="material-symbols-outlined text-primary text-3xl">contact_support</span>
      </div>
      <div>
        <h3 class="font-label-sm text-label-sm text-on-surface uppercase tracking-widest">Priority Support</h3>
        <p class="text-on-surface-variant font-label-sm text-label-sm mt-1">Technical assistance within 12 hours.</p>
      </div>
    </div>
  </section>
</main>

{%- comment -%}
  ----------------------------------------------------------------------------
  Cart-page controller (Liquid → JS bridge).

  Shopify endpoints used:
    POST /cart/change.js   { id: line_key, quantity: N }   ← qty + remove
    POST /cart/update.js   { discount: 'CODE' | '' }       ← clear discount
    GET  /discount/CODE?redirect=/cart                     ← apply discount

  We intentionally reload the page after every mutation. That keeps the
  Liquid render the source of truth (no need to re-template the cart with
  JS) and is fine for a single-line shop.
  ----------------------------------------------------------------------------
{%- endcomment -%}
{%- if cart.item_count > 0 -%}
<script>
  (() => {
    'use strict';

    const PROMO_CODE   = 'LAUNCH10';
    const promoApplied = {{ promo_applied | json }};

    const promoForm  = document.getElementById('promoForm');
    const promoInput = document.getElementById('promo');
    const promoMsg   = document.getElementById('promoMsg');
    let errorTimer   = null;

    // ---- Inline error display (matches the original UX) -------------------
    function clearError() {
      promoMsg.textContent = '';
      promoMsg.classList.remove('text-error');
      if (errorTimer) { clearTimeout(errorTimer); errorTimer = null; }
    }
    function showError(message) {
      promoMsg.textContent = message;
      promoMsg.classList.add('text-error');
      if (errorTimer) clearTimeout(errorTimer);
      errorTimer = setTimeout(clearError, 4000);
    }
    promoInput.addEventListener('input', () => { if (promoMsg.textContent) clearError(); });

    // ---- Promo apply / remove --------------------------------------------
    async function applyPromo() {
      const raw = promoInput.value.trim();
      if (!raw)                                  { showError('Please enter a code.'); return; }
      if (raw.toUpperCase() !== PROMO_CODE)      { showError('Invalid promo code.');  return; }
      // /discount/CODE redirects through Shopify, which writes the discount
      // to the cart cookie. ?redirect=/cart sends us back here on success.
      window.location.href = '/discount/' + encodeURIComponent(PROMO_CODE) + '?redirect=' + encodeURIComponent('{{ routes.cart_url }}');
    }

    async function removePromo() {
      try {
        await fetch('{{ routes.cart_update_url }}.js', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body:    JSON.stringify({ discount: '' }),
        });
      } catch (e) { /* ignore — falls through to reload */ }
      window.location.reload();
    }

    promoForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (promoApplied) removePromo();
      else              applyPromo();
    });

    // ---- Quantity +/- ----------------------------------------------------
    async function changeLine(key, quantity) {
      const res = await fetch('{{ routes.cart_change_url }}.js', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body:    JSON.stringify({ id: key, quantity }),
      });
      if (!res.ok) throw new Error('cart change failed');
      window.location.reload();   // reload so Liquid recomputes the totals
    }

    document.querySelectorAll('.qty-inc').forEach(btn => {
      btn.addEventListener('click', () => {
        const line = btn.closest('.cart-line');
        const cur  = parseInt(line.querySelector('.qty-val').textContent, 10) || 1;
        changeLine(btn.dataset.lineKey, Math.min(99, cur + 1)).catch(() => {});
      });
    });
    document.querySelectorAll('.qty-dec').forEach(btn => {
      btn.addEventListener('click', () => {
        const line = btn.closest('.cart-line');
        const cur  = parseInt(line.querySelector('.qty-val').textContent, 10) || 1;
        // quantity 0 removes the line — Shopify's documented behaviour.
        changeLine(btn.dataset.lineKey, Math.max(0, cur - 1)).catch(() => {});
      });
    });

    // ---- Remove product (no UNDO, per spec) ------------------------------
    document.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        changeLine(btn.dataset.lineKey, 0).catch(() => {});
      });
    });
  })();
</script>
{%- endif -%}
