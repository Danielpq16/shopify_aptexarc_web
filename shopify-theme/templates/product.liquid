{%- comment -%}
  ============================================================================
  templates/product.liquid — Product detail page (R36S).
  Replaces v2/product.html. Differences vs the static file:
    1. Title, price, description and stock label come from {{ product.* }}.
    2. The seven colour swatches and thumbnails are generated by iterating
       product.variants. Each carries data-variant-id (Shopify's primary key
       for the variant) and data-variant-image (its featured image URL),
       which the JS uses to swap the main image, update the colour label,
       update the breadcrumb, and most importantly update the hidden
       <input name="id"> on the Add to Cart form so we POST the right
       variant to /cart/add.
    3. Quantity controls are wired to a real <input name="quantity"> so the
       form submission carries the chosen amount natively.
    4. Add to Cart is a real form posting to {{ routes.cart_add_url }} —
       no client-side carts, no localStorage. Shopify owns the cart state.
  ============================================================================
{%- endcomment -%}

{%- comment -%}
  Pick the variant Shopify thinks should be selected — either the one in
  ?variant= URL param or the first available. This drives the initial state
  of the page (main image, swatches, stock label, hidden form input).
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign current_image   = current_variant.featured_image | default: product.featured_image -%}

<main class="max-w-max-width mx-auto px-margin py-lg">

  <!-- Breadcrumb ============================================================== -->
  <nav class="flex items-center gap-xs mb-lg font-label-sm text-label-sm text-on-surface-variant">
    <a class="hover:text-primary transition-colors" href="{{ routes.root_url }}#colors">Store</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a class="hover:text-primary transition-colors" href="{{ product.url }}">{{ product.title }}</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-on-surface" id="crumbColor">
      {{ current_variant.option1 | default: current_variant.title }}
    </span>
  </nav>

  <section class="grid grid-cols-1 lg:grid-cols-12 gap-xl">

    <!-- Left: Product Showcase ============================================== -->
    <div class="lg:col-span-7 flex flex-col gap-md">
      <div class="aspect-square bg-surface-container border border-outline-variant overflow-hidden">
        {%- comment -%}
          Main image. JS will replace its src with the active variant's image
          on swatch / thumbnail click — see the colour-selector script at the
          bottom of this template.
        {%- endcomment -%}
        <img id="mainProductImg"
             class="w-full h-full object-cover"
             alt="{{ product.title }} in {{ current_variant.option1 | default: current_variant.title }}"
             src="{{ current_image | image_url: width: 1200 }}"
             width="1200" height="1200">
      </div>

      {%- comment -%}
        Thumbnail row — one per variant. Each carries data-variant-id and
        data-variant-image so click handling is symmetrical with the colour
        circle swatches below.
      {%- endcomment -%}
      <div class="grid grid-cols-4 sm:grid-cols-7 gap-sm" id="thumbGrid">
        {%- for variant in product.variants -%}
          {%- assign v_image = variant.featured_image | default: variant.image | default: product.featured_image -%}
          {%- assign is_active = false -%}
          {%- if variant.id == current_variant.id -%}{%- assign is_active = true -%}{%- endif -%}
          <button type="button"
                  class="aspect-square bg-surface-container overflow-hidden hover:border-primary transition-colors thumb-btn {% if is_active %}border-2 border-primary{% else %}border border-outline-variant{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-variant-image="{{ v_image | image_url: width: 1200 }}"
                  data-variant-name="{{ variant.option1 | default: variant.title | escape }}"
                  data-variant-available="{{ variant.available }}"
                  aria-label="Show {{ variant.option1 | default: variant.title }} variant"
                  aria-pressed="{{ is_active }}">
            <img class="w-full h-full object-cover"
                 alt="{{ variant.option1 | default: variant.title }} thumbnail"
                 src="{{ v_image | image_url: width: 300 }}"
                 loading="lazy"
                 width="300" height="300">
          </button>
        {%- endfor -%}
      </div>
    </div>

    <!-- Right: Purchase Panel =============================================== -->
    <div class="lg:col-span-5 flex flex-col">
      <div class="mb-sm">
        <span class="font-label-sm text-label-sm text-primary-fixed uppercase tracking-widest">
          {{ product.type | default: 'Handheld Performance' }}
        </span>
        <h1 class="font-display-xl text-headline-lg mt-xs text-on-surface">{{ product.title }}</h1>
      </div>

      <div class="flex items-center gap-sm mb-lg">
        <div class="flex flex-col">
          <div class="flex items-baseline gap-sm">
            {%- comment -%}
              `money` filter picks up the shop's currency format, so no need
              to hard-code "85,99€".
            {%- endcomment -%}
            <span id="productPrice" class="font-headline-md text-headline-md text-on-surface">
              {{ current_variant.price | money }}
            </span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s id="productCompareAt" class="font-body-md text-on-surface-variant">
                {{ current_variant.compare_at_price | money }}
              </s>
            {%- endif -%}
          </div>
          <span id="stockLabel" class="font-label-sm text-label-sm mt-xs {% if current_variant.available %}text-primary{% else %}text-error{% endif %}">
            {%- if current_variant.available -%}In stock &middot; Ready to ship{%- else -%}Sold out{%- endif -%}
          </span>
        </div>
      </div>

      {%- comment -%}
        --------------------------------------------------------------------
        Add to Cart form — native Shopify endpoint.
          - input[name="id"]       → variant id (updated by JS on swatch click)
          - input[name="quantity"] → driven by the +/- buttons (JS keeps it in
                                     sync with the visible counter)
          - submit POSTs to /cart/add and Shopify redirects to /cart on success
        --------------------------------------------------------------------
      {%- endcomment -%}
      <form id="productForm" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">

        <!-- Color Selection ================================================ -->
        <div class="mb-lg">
          <p class="font-label-sm text-label-sm text-on-surface-variant mb-sm">
            <span class="text-on-surface-variant">Color:</span>
            <span class="text-on-surface" id="colorLabel">
              {{ current_variant.option1 | default: current_variant.title }}
            </span>
          </p>
          <div class="flex flex-wrap gap-sm" id="colorSwatches" role="radiogroup" aria-label="Color">
            {%- for variant in product.variants -%}
              {%- assign v_image = variant.featured_image | default: variant.image | default: product.featured_image -%}
              {%- assign is_active = false -%}
              {%- if variant.id == current_variant.id -%}{%- assign is_active = true -%}{%- endif -%}
              {%- comment -%}
                Inline swatch background. Shopify swatches typically rely on
                a metafield colour value or option metaobject; we keep the
                static palette to honour the original design's swatches.
                Map below derives the swatch background from the colour name.
              {%- endcomment -%}
              {%- assign swatch_bg = '#888888' -%}
              {%- assign cname = variant.option1 | default: variant.title | downcase -%}
              {%- case cname -%}
                {%- when 'black'      -%}{%- assign swatch_bg = '#121212' -%}
                {%- when 'full white' -%}{%- assign swatch_bg = '#ffffff' -%}
                {%- when 'lake blue'  -%}{%- assign swatch_bg = '#3b82f6' -%}
                {%- when 'purple'     -%}{%- assign swatch_bg = '#a855f7' -%}
                {%- when 'red'        -%}{%- assign swatch_bg = '#ef4444' -%}
                {%- when 'white'      -%}{%- assign swatch_bg = '#e5e2e1' -%}
                {%- when 'yellow'     -%}{%- assign swatch_bg = '#eab308' -%}
              {%- endcase -%}
              <button type="button"
                      class="w-8 h-8 rounded-full transition-all color-btn {% if is_active %}border-2 border-primary ring-2 ring-offset-2 ring-offset-background ring-transparent{% else %}border border-outline-variant hover:border-primary{% endif %} {% unless variant.available %}opacity-40 cursor-not-allowed{% endunless %}"
                      style="background-color: {{ swatch_bg }};"
                      data-variant-id="{{ variant.id }}"
                      data-variant-image="{{ v_image | image_url: width: 1200 }}"
                      data-variant-name="{{ variant.option1 | default: variant.title | escape }}"
                      data-variant-available="{{ variant.available }}"
                      data-variant-price="{{ variant.price | money }}"
                      role="radio"
                      aria-checked="{{ is_active }}"
                      aria-label="{{ variant.option1 | default: variant.title }}{% unless variant.available %} (sold out){% endunless %}"
                      title="{{ variant.option1 | default: variant.title }}"></button>
            {%- endfor -%}
          </div>
        </div>

        <!-- Quantity & Submit ============================================== -->
        <div class="flex flex-col gap-sm mb-lg">
          <div class="flex items-center justify-between bg-surface-container border border-outline-variant p-sm">
            <span class="font-label-sm text-label-sm text-on-surface-variant">Quantity</span>
            <div class="flex items-center gap-md">
              <button type="button" id="qtyDec" class="material-symbols-outlined text-on-surface-variant hover:text-primary" aria-label="Decrease quantity">remove</button>
              {%- comment -%}
                Real <input>, not a span — Shopify needs a `quantity` field
                on the form. We hide its native chrome with class .sr-like
                while keeping it interactive for screen readers and for the
                form payload.
              {%- endcomment -%}
              <input type="number"
                     id="qtyVal"
                     name="quantity"
                     value="1"
                     min="1"
                     max="99"
                     inputmode="numeric"
                     class="w-10 text-center font-body-md text-body-md text-on-surface bg-transparent border-none focus:outline-none focus:ring-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
              <button type="button" id="qtyInc" class="material-symbols-outlined text-on-surface-variant hover:text-primary" aria-label="Increase quantity">add</button>
            </div>
          </div>
          <button type="submit"
                  id="addToCartBtn"
                  class="w-full bg-primary-container text-on-primary-container py-4 font-label-sm text-label-sm uppercase tracking-widest hover:brightness-110 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:brightness-100"
                  {% unless current_variant.available %}disabled{% endunless %}>
            <span id="addToCartLabel">{% if current_variant.available %}Add to Cart{% else %}Sold out{% endif %}</span>
          </button>
        </div>
      </form>

      <!-- Payment Badges ================================================== -->
      <div class="flex items-center justify-center gap-md opacity-40 grayscale">
        <span class="material-symbols-outlined">credit_card</span>
        <span class="material-symbols-outlined">account_balance_wallet</span>
        <span class="material-symbols-outlined">payments</span>
        <span class="material-symbols-outlined">contactless</span>
        <span class="material-symbols-outlined">dock</span>
      </div>
    </div>
  </section>

  <!-- Trust Strip (static) ================================================== -->
  <section class="mt-xl border-t border-outline-variant pt-xl">
    <div class="grid grid-cols-1 gap-md md:grid-cols-3">
      <div class="flex flex-col gap-xs p-md bg-surface-container-low border border-outline-variant">
        <span class="material-symbols-outlined text-primary text-[32px]">local_shipping</span>
        <h3 class="font-headline-md text-body-lg text-on-surface">Global Transit</h3>
        <p class="font-body-md text-label-sm text-on-surface-variant">Secure, tracked shipping worldwide.</p>
      </div>
      <div class="flex flex-col gap-xs p-md bg-surface-container-low border border-outline-variant">
        <span class="material-symbols-outlined text-primary text-[32px]">security</span>
        <h3 class="font-headline-md text-body-lg text-on-surface">Secure Checkout</h3>
        <p class="font-body-md text-label-sm text-on-surface-variant">End-to-end encrypted transactions.</p>
      </div>
      <div class="flex flex-col gap-xs p-md bg-surface-container-low border border-outline-variant">
        <span class="material-symbols-outlined text-primary text-[32px]">support_agent</span>
        <h3 class="font-headline-md text-body-lg text-on-surface">Expert Support</h3>
        <p class="font-body-md text-label-sm text-on-surface-variant">Hardware specialists ready to help.</p>
      </div>
    </div>
  </section>

  {%- if product.description != blank -%}
    <section class="mt-xl border-t border-outline-variant pt-xl">
      <div class="prose prose-invert max-w-none text-on-surface-variant font-body-md">
        {{ product.description }}
      </div>
    </section>
  {%- endif -%}
</main>

{%- comment -%}
  ----------------------------------------------------------------------------
  Variant + quantity controller. Same shape as the IIFE in product.html, with
  these differences:
    - Selecting a variant rewrites the URL via history.replaceState so the
      ?variant= query stays in sync (Shopify reads this on refresh / share).
    - It updates the hidden #variantId input, so submitting the form posts
      the right variant to /cart/add.
    - The price element + stock label + Add to Cart button enable / disable
      based on variant.available — replacing the static "In stock" copy
      from the HTML.
  ----------------------------------------------------------------------------
{%- endcomment -%}
<script>
  (() => {
    'use strict';

    const mainImg     = document.getElementById('mainProductImg');
    const colorLabel  = document.getElementById('colorLabel');
    const crumbColor  = document.getElementById('crumbColor');
    const variantId   = document.getElementById('variantId');
    const stockLabel  = document.getElementById('stockLabel');
    const priceEl     = document.getElementById('productPrice');
    const addBtn      = document.getElementById('addToCartBtn');
    const addLabel    = document.getElementById('addToCartLabel');
    const swatches    = document.querySelectorAll('.color-btn');
    const thumbs      = document.querySelectorAll('.thumb-btn');

    // CSS class sets used to flip a swatch / thumbnail in or out of the
    // active state. Same visual rules as product.html.
    const SWATCH_ACTIVE = ['border-primary', 'border-2', 'ring-2', 'ring-offset-2', 'ring-offset-background'];
    const SWATCH_IDLE   = ['border', 'border-outline-variant'];
    const THUMB_ACTIVE  = ['border-primary', 'border-2'];
    const THUMB_IDLE    = ['border', 'border-outline-variant'];

    function setSwatchState(btn, active) {
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
      btn.classList.toggle('ring-transparent', active);
      if (active) {
        btn.classList.remove(...SWATCH_IDLE);
        btn.classList.add(...SWATCH_ACTIVE);
      } else {
        btn.classList.remove(...SWATCH_ACTIVE);
        btn.classList.add(...SWATCH_IDLE);
      }
    }

    function setThumbState(btn, active) {
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      if (active) {
        btn.classList.remove(...THUMB_IDLE);
        btn.classList.add(...THUMB_ACTIVE);
      } else {
        btn.classList.remove(...THUMB_ACTIVE);
        btn.classList.add(...THUMB_IDLE);
      }
    }

    function selectVariant(id) {
      // Find any element (swatch or thumb) carrying this variant id; both
      // share the same data-* keys so either source works.
      const ref = document.querySelector('[data-variant-id="' + id + '"]');
      if (!ref) return;

      const name      = ref.dataset.variantName;
      const image     = ref.dataset.variantImage;
      const available = ref.dataset.variantAvailable === 'true';
      const price     = ref.dataset.variantPrice;

      // Swap the main image + alt text.
      if (image) {
        mainImg.src = image;
        mainImg.alt = mainImg.alt.replace(/in .+$/, 'in ' + name);
      }
      // Update the colour label, breadcrumb, and hidden form input.
      colorLabel.textContent = name;
      if (crumbColor) crumbColor.textContent = name;
      variantId.value = id;

      // Mirror the selection across both swatch + thumbnail rows.
      swatches.forEach(b => setSwatchState(b, b.dataset.variantId === id));
      thumbs.forEach(b   => setThumbState(b,   b.dataset.variantId === id));

      // Update the URL so the page is shareable in this state and a refresh
      // preserves the selection (Shopify reads ?variant= on load).
      const url = new URL(window.location.href);
      url.searchParams.set('variant', id);
      window.history.replaceState({}, '', url);

      // Reflect availability in the price + CTA + stock label.
      if (price && priceEl) priceEl.textContent = price;
      if (stockLabel) {
        stockLabel.textContent = available ? 'In stock · Ready to ship' : 'Sold out';
        stockLabel.classList.toggle('text-primary', available);
        stockLabel.classList.toggle('text-error',   !available);
      }
      addBtn.disabled = !available;
      if (addLabel) addLabel.textContent = available ? 'Add to Cart' : 'Sold out';
    }

    swatches.forEach(b => b.addEventListener('click', () => selectVariant(b.dataset.variantId)));
    thumbs.forEach(b   => b.addEventListener('click',   () => selectVariant(b.dataset.variantId)));

    // Quantity controls — keep the form input clamped between 1 and 99 and
    // sync the displayed value with whatever the user types directly.
    const qtyVal = document.getElementById('qtyVal');
    const qtyInc = document.getElementById('qtyInc');
    const qtyDec = document.getElementById('qtyDec');

    function setQty(n) {
      const next = Math.max(1, Math.min(99, n || 1));
      qtyVal.value = String(next);
    }

    qtyInc.addEventListener('click', () => setQty(parseInt(qtyVal.value, 10) + 1));
    qtyDec.addEventListener('click', () => setQty(parseInt(qtyVal.value, 10) - 1));
    qtyVal.addEventListener('change', () => setQty(parseInt(qtyVal.value, 10)));
  })();
</script>
