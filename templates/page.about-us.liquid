{%- comment -%}
  ============================================================================
  templates/page.about-us.liquid — About page.
  Replaces v2/about.html. The structure is purely editorial — no dynamic
  data — so this template stays close to the static markup. The only
  Shopify-specific touches:
    1. Banner / lifestyle / variant images come from assets via
       `{{ 'filename.png' | asset_url }}`.
    2. Page title, the "Stay updated" CTA target and the closing CTA all
       wire into Shopify objects (page.title, routes.root_url, etc.).
    3. {{ page.content }} is rendered at the end so the merchant can
       extend the page from the admin without touching the theme.
  In Shopify admin, create a Page with handle "about" and template suffix
  "about" so this file is used.
  ============================================================================
{%- endcomment -%}
<main class="flex-grow">

  <!-- Hero Section ============================================================== -->
  <section class="relative w-full h-[60vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img alt="" class="w-full h-full object-cover opacity-60"
           src="{{ 'banner bueno.png' | asset_url }}">
      <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 text-center px-margin max-w-3xl">
      <span class="font-label-sm text-label-sm text-primary uppercase tracking-[0.2em] mb-md block">Legacy in your pocket</span>
      <h1 class="font-display-xl text-display-xl mb-md">{{ page.title | default: 'Engineering Nostalgia' }}</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant">The hardware that honors the golden age of gaming. Precise. Honest. Uncompromising.</p>
    </div>
  </section>

  <!-- Mission Bento Grid ======================================================== -->
  <section class="max-w-max-width mx-auto px-margin py-xl">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
      <!-- Large Story Card -->
      <div class="md:col-span-8 bg-surface-container-low border border-outline-variant p-lg flex flex-col justify-between">
        <div>
          <h2 class="font-headline-lg text-headline-lg mb-md">Our Philosophy</h2>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
            At AptexArc, we believe that hardware should feel like an extension of the experience it provides. For the nostalgic gamer, that means tactile response, weight, and material integrity that mirrors the original classics while embracing modern technological advancements.
          </p>
        </div>
        <div class="mt-xl grid grid-cols-2 gap-md">
          <div>
            <span class="font-label-sm text-label-sm text-primary block mb-xs">PRECISION</span>
            <p class="font-body-md text-body-md">CNC-milled aluminum shells for industrial-grade durability.</p>
          </div>
          <div>
            <span class="font-label-sm text-label-sm text-primary block mb-xs">HONESTY</span>
            <p class="font-body-md text-body-md">No cheap plastics. No gimmick features. Just pure play.</p>
          </div>
        </div>
      </div>
      <!-- Secondary Visual Card -->
      <div class="md:col-span-4 bg-surface-container border border-outline-variant overflow-hidden group">
        <img alt="AptexArc lifestyle"
             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
             src="{{ 'publish 3.png' | asset_url }}">
      </div>
      <!-- Feature Split -->
      <div class="md:col-span-4 bg-surface-container border border-outline-variant overflow-hidden">
        {%- comment -%}
          The Yellow R36S photo on the static page came from assets. In a
          theme it makes more sense to render the featured product's image
          when one is configured, so the page automatically adapts as the
          product roster changes. Falls back to the static asset.
        {%- endcomment -%}
        {%- assign showcase = settings.featured_product | default: all_products['r36s'] -%}
        {%- if showcase != blank and showcase.featured_image != blank -%}
          <img alt="{{ showcase.title }}"
               class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
               src="{{ showcase.featured_image | image_url: width: 800 }}">
        {%- else -%}
          <img alt="AptexArc product"
               class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
               src="{{ 'publish 1.png' | asset_url }}">
        {%- endif -%}
      </div>
      <div class="md:col-span-4 bg-surface-container-high border border-outline-variant p-md flex flex-col justify-center text-center">
        <div class="text-primary mb-sm">
          <span class="material-symbols-outlined text-[48px]">hardware</span>
        </div>
        <h3 class="font-headline-md text-headline-md mb-xs">Machined Quality</h3>
        <p class="font-label-sm text-label-sm text-on-surface-variant">Every button press is a calculated interaction.</p>
      </div>
      <div class="md:col-span-4 bg-primary-container text-on-primary-container p-md flex flex-col justify-end">
        <p class="font-headline-md text-headline-md leading-tight">Join the evolution of classic gaming.</p>
        <div class="mt-md">
          <a href="{{ routes.root_url }}#colors"
             class="inline-block bg-on-primary-container text-primary-container px-md py-xs font-label-sm text-label-sm hover:opacity-90 transition-opacity">
            STAY UPDATED
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section (static) =================================================== -->
  <section class="bg-surface-container-lowest border-y border-outline-variant py-xl">
    <div class="max-w-max-width mx-auto px-margin">
      <div class="flex flex-col md:flex-row gap-xl items-start">
        <div class="md:w-1/3">
          <h2 class="font-headline-lg text-headline-lg sticky top-[120px]">The Arc Standard</h2>
        </div>
        <div class="md:w-2/3 grid grid-cols-1 gap-lg">
          <div class="border-b border-outline-variant pb-md">
            <span class="font-label-sm text-label-sm text-primary mb-sm block">01 / DESIGN</span>
            <p class="font-body-lg text-body-lg text-on-surface">We prioritize the ergonomic curve and the resistance of a shoulder button over marketing trends. Design starts at the fingertips.</p>
          </div>
          <div class="border-b border-outline-variant pb-md">
            <span class="font-label-sm text-label-sm text-primary mb-sm block">02 / TECHNOLOGY</span>
            <p class="font-body-lg text-body-lg text-on-surface">Chipsets are optimized for latency-free emulation, ensuring that your reflexes are never hampered by modern overhead.</p>
          </div>
          <div class="pb-md">
            <span class="font-label-sm text-label-sm text-primary mb-sm block">03 / SUSTAINABILITY</span>
            <p class="font-body-lg text-body-lg text-on-surface">Built to last decades, not seasons. Repairability is at the core of our component architecture.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial body — admin-editable from Shopify Pages -------------------- -->
  {%- if page.content != blank -%}
    <section class="py-xl">
      <div class="max-w-3xl mx-auto px-margin prose prose-invert text-on-surface-variant font-body-md">
        {{ page.content }}
      </div>
    </section>
  {%- endif -%}

  <!-- CTA Section (static) ====================================================== -->
  <section class="py-xl mb-xl">
    <div class="max-w-max-width mx-auto px-margin text-center">
      <div class="inline-block border border-outline-variant p-xl max-w-2xl mx-auto">
        <h2 class="font-headline-lg text-headline-lg mb-md">Ready to experience honest hardware?</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-lg">Explore our current lineup of premium handheld systems and see the AptexArc difference for yourself.</p>
        <a class="inline-block bg-primary text-on-primary px-lg py-md font-label-sm text-label-sm tracking-widest hover:opacity-90 transition-opacity"
           href="{{ routes.root_url }}#colors">
          GO TO STORE
        </a>
      </div>
    </div>
  </section>
</main>
