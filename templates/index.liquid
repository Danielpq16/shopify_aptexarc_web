{%- comment -%}
  ============================================================================
  templates/index.liquid — Home page.
  Replaces v2/index.html. Differences vs the static file:
    1. Header / footer come from layout/theme.liquid (sections).
    2. Hero is rendered via the configurable `sections/hero.liquid`.
    3. The colour grid iterates a real Shopify product's variants
       (settings.featured_product, fallback handle "r36s") instead of seven
       hard-coded <a> cards. Each card now jumps to /products/r36s?variant=ID
       so the product page can preselect the colour.
  Specs, Intuitive Controls, lifestyle gallery, trust strip and FAQ stay as
  static markup per the original brief.
  ============================================================================
{%- endcomment -%}

{%- comment -%} Hero — see sections/hero.liquid for schema + customizer. {%- endcomment -%}
{% section 'hero' %}

{%- comment -%}
  Resolve the featured product the colour grid renders. Order of preference:
    1. The product picked in Theme Settings ➜ Brand ➜ R36S product.
    2. The product whose handle is "r36s".
  If both are missing the section renders a friendly empty state so the page
  never crashes on a fresh install.
{%- endcomment -%}
{%- assign r36s = settings.featured_product -%}
{%- if r36s == blank or r36s == empty -%}
  {%- assign r36s = all_products['r36s'] -%}
{%- endif -%}

<!-- Color Selector ============================================================ -->
<section class="py-xl px-margin max-w-max-width mx-auto" id="colors">
  <div class="text-center mb-xl">
    <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">Choose your color</h2>
    <div class="h-base w-sm bg-primary mx-auto"></div>
  </div>

  {%- if r36s != blank and r36s.variants.size > 0 -%}
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-md">
      {%- comment -%}
        One card per variant. variant.option1 is the colour name when the
        product has a single "Color" option. variant.featured_image renders
        the photo uploaded against that variant in admin.
      {%- endcomment -%}
      {%- for variant in r36s.variants -%}
        {%- assign variant_image = variant.featured_image | default: variant.image | default: r36s.featured_image -%}
        <a class="group border border-outline-variant bg-surface-container p-sm hover:border-primary transition-colors {% unless variant.available %}opacity-60{% endunless %}"
           href="{{ r36s.url }}?variant={{ variant.id }}"
           aria-label="View {{ variant.option1 | default: variant.title }} R36S">
          <div class="aspect-square bg-surface-container-highest mb-sm overflow-hidden">
            {%- if variant_image != blank -%}
              <img alt="{{ variant.option1 | default: variant.title }} R36S"
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                   src="{{ variant_image | image_url: width: 600 }}"
                   loading="lazy"
                   width="600" height="600">
            {%- endif -%}
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant group-hover:text-primary">
            {{ variant.option1 | default: variant.title }}
          </span>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- comment -%} Empty state — only seen when no product is configured. {%- endcomment -%}
    <p class="text-center text-on-surface-variant font-body-md">
      Configure a product in <em>Theme settings ▸ Brand ▸ R36S product</em> to populate this grid.
    </p>
  {%- endif -%}
</section>

