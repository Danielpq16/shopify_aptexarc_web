<!doctype html>
{%- comment -%}
  ============================================================================
  layout/theme.liquid — Global wrapper for every storefront page.
  Counterpart of the <html><head><body> chrome that the static index.html /
  product.html / cart.html files repeat. Shopify injects {{ content_for_layout }}
  with the matching template (templates/index.liquid, templates/product.liquid…).
  ============================================================================
{%- endcomment -%}
<html class="dark" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#131313">

  {%- comment -%} Title pattern matches the per-page <title> from the static files. {%- endcomment -%}
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {%- comment -%} Favicon — reuse the AptexArc logo asset. {%- endcomment -%}
  <link rel="icon" type="image/png" href="{{ 'logo_white_bg_removed_sin_fondo.png' | asset_url }}">

  {%- comment -%}
    External libraries copied verbatim from the static HTML. Tailwind via CDN
    + the custom config block below (DESIGN.md tokens). Keeping the CDN scripts
    avoids touching the visual layer at all.
  {%- endcomment -%}
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  {%- comment -%}
    Tailwind theme tokens (colors, spacing, typography, radii). Extracted from
    the per-page <script id="tailwind-config"> blocks in the .html files —
    centralised here so every Liquid template inherits the same palette.
  {%- endcomment -%}
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "inverse-surface": "#e5e2e1", "on-secondary": "#303030", "outline-variant": "#3f4942",
            "outline": "#89938b", "on-error-container": "#ffdad6", "surface-container-low": "#1c1b1b",
            "on-primary": "#003921", "on-tertiary": "#2f3131", "on-primary-fixed-variant": "#005232",
            "primary-container": "#2e7d56", "primary-fixed": "#a4f4c4", "secondary-fixed": "#e5e2e1",
            "inverse-primary": "#186b46", "on-surface": "#e5e2e1", "surface-container-lowest": "#0e0e0e",
            "on-primary-container": "#cfffdf", "secondary-container": "#474746", "inverse-on-surface": "#313030",
            "surface-variant": "#353534", "on-tertiary-fixed-variant": "#464747", "on-secondary-fixed-variant": "#474746",
            "primary": "#88d7a9", "surface": "#131313", "error": "#ffb4ab", "tertiary-container": "#6f6f6f",
            "background": "#131313", "on-secondary-fixed": "#1b1b1c", "primary-fixed-dim": "#88d7a9",
            "on-error": "#690005", "surface-dim": "#131313", "surface-container": "#201f1f",
            "surface-tint": "#88d7a9", "error-container": "#93000a", "tertiary-fixed-dim": "#c7c6c6",
            "on-secondary-container": "#b7b5b4", "on-tertiary-fixed": "#1a1c1c", "on-background": "#e5e2e1",
            "tertiary": "#c7c6c6", "surface-container-high": "#2a2a2a", "on-tertiary-container": "#f4f3f3",
            "on-primary-fixed": "#002111", "on-surface-variant": "#bfc9c0", "secondary-fixed-dim": "#c8c6c5",
            "secondary": "#c8c6c5", "surface-bright": "#393939", "tertiary-fixed": "#e3e2e2",
            "surface-container-highest": "#353534"
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
          spacing: {
            "gutter": "24px", "margin": "32px", "xs": "8px", "max-width": "1280px",
            "lg": "48px", "xl": "80px", "sm": "16px", "base": "4px", "md": "24px"
          },
          fontFamily: {
            "body-lg": ["Inter"], "label-sm": ["Inter"], "headline-md": ["Inter"],
            "body-md": ["Inter"], "headline-lg": ["Inter"], "display-xl": ["Inter"]
          },
          fontSize: {
            "body-lg": ["18px", { "lineHeight": "1.6", "letterSpacing": "0", "fontWeight": "400" }],
            "label-sm": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "600" }],
            "headline-md": ["24px", { "lineHeight": "1.3", "letterSpacing": "0", "fontWeight": "600" }],
            "body-md": ["16px", { "lineHeight": "1.6", "letterSpacing": "0", "fontWeight": "400" }],
            "headline-lg": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "display-xl": ["64px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }]
          }
        }
      }
    };
  </script>

  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      vertical-align: middle;
    }
    body { background-color: #131313; color: #e5e2e1; }
  </style>

  {%- comment -%} Required by Shopify — injects analytics, app proxies, etc. {%- endcomment -%}
  {{ content_for_header }}
</head>

<body class="font-body-md text-body-md selection:bg-primary-container selection:text-on-primary-container">

  {%- comment -%} Shared top navigation — see sections/header.liquid {%- endcomment -%}
  {% sections 'header-group' %}

  <main role="main" id="MainContent">
    {{ content_for_layout }}
  </main>

  {%- comment -%} Shared footer — see sections/footer.liquid {%- endcomment -%}
  {% sections 'footer-group' %}

</body>
</html>
