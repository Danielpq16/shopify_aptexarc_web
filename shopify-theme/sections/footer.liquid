{%- comment -%}
  ============================================================================
  sections/footer.liquid — Shared footer for every template.
  Plain Liquid — no dynamic data beyond shop.name and the page handles for
  Contact / FAQ / Privacy. Replaces the duplicated <footer> block from each
  static .html file.
  ============================================================================
{%- endcomment -%}
<footer class="bg-surface border-t border-outline-variant">
  <div class="flex flex-col items-center w-full px-margin py-xl max-w-max-width mx-auto space-y-md">

    {%- comment -%} Logo, same asset as the header. {%- endcomment -%}
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      <img alt="{{ shop.name }}"
           class="h-8 w-auto object-contain"
           src="{{ 'logo_white_bg_removed_sin_fondo.png' | asset_url }}"
           width="64" height="32">
    </a>

    <div class="flex flex-wrap justify-center gap-md">
      {%- comment -%}
        Contact / FAQ / Privacy footer links. Resolve to Shopify pages by
        handle when present; fall back to a hard-coded path otherwise so the
        footer never ships broken links.
      {%- endcomment -%}
      <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
         href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
      <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
         href="{{ pages.faq.url | default: '#' }}">FAQ</a>
      <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors"
         href="{{ pages['privacy-policy'].url | default: shop.privacy_policy.url | default: '#' }}">Privacy</a>
    </div>

    <p class="font-body-md text-body-md text-on-surface-variant opacity-80">
      {{ shop.name }} &copy; {{ 'now' | date: '%Y' }}. Honest hardware.
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [
    { "name": "Footer" }
  ]
}
{% endschema %}
